# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- LinkedIn session (required for everything except public_jsonld) --------
# How to get these:
#   1. Log in to LinkedIn in a browser. Use a throwaway account.
#   2. Open developer tools, then Application, then Cookies,
#      then https://www.linkedin.com.
#   3. Copy the value of li_at and the value of JSESSIONID.
# JSESSIONID looks like "ajax:1234567890123456789". Keep or drop the quotes,
# the service handles both.
LI_AT=
JSESSIONID=

# Optional: several accounts, to spread load and survive one dead cookie.
# Format: li_at_value:jsessionid_value, separated by commas.
LI_AT_POOL=

# --- Our own API -----------------------------------------------------------
# Comma separated. Leave empty and the API stays open, which suits a demo.
API_KEYS=
PORT=8080
LOG_LEVEL=INFO

# --- Pacing. These protect the LinkedIn account. ---------------------------
OUTBOUND_RPS=0.5
OUTBOUND_JITTER_MS=400
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_S=20
MAX_RETRIES=3

# --- Cache -----------------------------------------------------------------
CACHE_TTL_S=3600
CACHE_MAX_ENTRIES=1000
# REDIS_URL=redis://localhost:6379/0

# --- Strategy control ------------------------------------------------------
# Order matters. The service stops at the first strategy that returns enough.
STRATEGIES=voyager_profile_view,voyager_dash,embedded_json,public_jsonld

# LinkedIn rotates these GraphQL build hashes. When the dash strategy starts
# to fail, read a fresh hash from a real browser request and set it here.
# No code change and no new image are needed.
# QUERY_ID_PROFILE_COMPONENTS=voyagerIdentityDashProfileComponents.<hash>

# Point at a mock for local end to end runs. Leave unset in production.
# LINKEDIN_BASE_URL=http://127.0.0.1:9100
